# CloudSigma API credentials
CS_API_BASE="https://zrh.cloudsigma.com/api/2.0"
CS_USER="your-email@example.com"
CS_PASS="your-password-here"

# VM configuration
VM_NAME="dhcp-nat-gw"
VM_CPU=2000        # MHz
VM_MEM=1073741824  # 1 GB in bytes

# Ubuntu 24.04 LTS library drive UUID (region-specific)
LIB_DRIVE_UUID="08da9b85-22fc-4868-8a66-73cec716c710"

# SSH public key to inject into the VM
SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEPOvj+wmk1WicZkFQqqfoSVXjijW3XHbm2wm/NDwS8j voa@kube-dc-bastion"

# Cloud VLAN (shared between provider and customer accounts)
CLOUD_VLAN_UUID="eb22472a-ce52-460b-9902-f7624f2f5365"
CLOUD_VLAN_IP="100.64.200.92" # keep it unique
CLOUD_VLAN_PREFIX="16"

# Customer private VLAN
CUSTOMER_VLAN_UUID="09d36477-388c-46ce-9071-b7c5176ffc8c"
CUSTOMER_VLAN_IP="10.8.0.1"
CUSTOMER_VLAN_PREFIX="24"

# DHCP range served on the customer VLAN
DHCP_RANGE_START="10.8.0.10"
DHCP_RANGE_END="10.8.0.250"
DHCP_LEASE_TIME="12h"
